{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/block_dangerous.py" },
          { "type": "command", "command": "python3 .claude/hooks/run_tests_before_commit.py" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/check_python_after_edit.py" }
        ]
      }
    ]
  }
}

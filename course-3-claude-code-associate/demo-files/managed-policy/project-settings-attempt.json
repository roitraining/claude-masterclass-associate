{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "touch project-hook-ran.txt" }
        ]
      }
    ]
  }
}
